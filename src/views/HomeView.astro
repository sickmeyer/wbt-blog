---
import type { Page } from 'astro';
import PostCard from '../components/PostCard.astro';
import { CHURCH } from '../consts';
import Base from '../layouts/Base.astro';
import { type Lang, t } from '../lib/i18n';
import type { Post } from '../lib/posts';

interface Props {
	page: Page<Post>;
	lang: Lang;
}
const { page, lang } = Astro.props;
const tr = t(lang);
const first = page.currentPage === 1;
---

<Base
	lang={lang}
	title={first ? undefined : `${tr.articles}: ${tr.page(page.currentPage, page.lastPage)}`}
	description={tr.rssDescription}
>
	{
		first && (
			<section class="intro">
				<p class="eyebrow">{CHURCH.name}</p>
				<h1>{tr.siteTitle}</h1>
				<p>{tr.homeIntro}</p>
			</section>
		)
	}
	{!first && (
		<header class="page-head">
			<h1>{tr.articles}</h1>
			<p>{tr.page(page.currentPage, page.lastPage)}</p>
		</header>
	)}

	{
		page.data.length === 0 ? (
			<p class="empty">
				{tr.noPosts}{' '}
				<a href={CHURCH.url}>wbt4god.com</a> {tr.forServiceTimes}
			</p>
		) : (
			<div class="list">
				{page.data.map((post) => (
					<PostCard post={post} />
				))}
			</div>
		)
	}

	{
		page.lastPage > 1 && (
			<nav class="pager" aria-label="Pagination">
				{page.url.prev ? <a href={page.url.prev}>{tr.newerArticles}</a> : <span />}
				<span class="count">{tr.page(page.currentPage, page.lastPage)}</span>
				{page.url.next ? <a href={page.url.next}>{tr.olderArticles}</a> : <span />}
			</nav>
		)
	}
</Base>

<style>
	.intro {
		margin-bottom: 2.5rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--border);
	}

	.intro h1 {
		font-size: clamp(2.2rem, 6vw, 3.2rem);
		margin: 0 0 0.6rem;
	}

	.intro p:last-child {
		margin: 0;
		font-size: 1.15rem;
		color: var(--text-dim);
		max-width: var(--measure);
	}

	.empty {
		color: var(--text-dim);
	}

	.pager {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		margin-top: 2rem;
		font-weight: 700;
	}

	.pager .count {
		font-weight: 400;
		color: var(--text-muted);
		font-size: 0.9rem;
	}
</style>
