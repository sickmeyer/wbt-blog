---
import Base from '../layouts/Base.astro';
import { type Lang, t } from '../lib/i18n';
import { formatDate, getPosts, postUrl } from '../lib/posts';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const posts = await getPosts(lang);
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
	const y = post.data.pubDate.getUTCFullYear();
	byYear.set(y, [...(byYear.get(y) ?? []), post]);
}
---

<Base lang={lang} title={tr.archive} description={`${tr.allArticles}. ${tr.rssDescription}`}>
	<header class="page-head">
		<p class="eyebrow">{tr.archive}</p>
		<h1>{tr.archiveTitle}</h1>
		<p>{tr.countArticles(posts.length)}</p>
	</header>

	{
		[...byYear].map(([year, list]) => (
			<section>
				<h2>{year}</h2>
				<ol>
					{list.map((post) => (
						<li>
							<time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
								{formatDate(post.data.pubDate, 'short', lang)}
							</time>
							<a href={postUrl(post)}>{post.data.title}</a>
							{post.isDraft && <span class="pill draft">{lang === 'es' ? 'Borrador' : 'Draft'}</span>}
						</li>
					))}
				</ol>
			</section>
		))
	}
</Base>

<style>
	section {
		margin-bottom: 2.5rem;
		max-width: var(--measure);
	}

	h2 {
		font-size: 1.5rem;
		margin: 0 0 0.75rem;
		padding-bottom: 0.4rem;
		border-bottom: 2px solid var(--red);
	}

	ol {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	li {
		display: grid;
		grid-template-columns: 7rem 1fr auto;
		gap: 0.25rem 1rem;
		padding: 0.55rem 0;
		border-bottom: 1px solid var(--border);
		align-items: baseline;
	}

	time {
		color: var(--text-muted);
		font-size: 0.9rem;
	}

	a {
		font-family: var(--font-read);
		font-size: 1.1rem;
		font-weight: 700;
		color: var(--text);
		text-decoration: none;
	}

	a:hover {
		color: var(--link);
		text-decoration: underline;
	}

	@media (max-width: 560px) {
		li {
			grid-template-columns: 1fr auto;
		}

		time {
			grid-column: 1 / -1;
		}
	}
</style>
