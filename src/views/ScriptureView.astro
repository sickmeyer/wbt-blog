---
import Base from '../layouts/Base.astro';
import { type Lang, ROUTES, t } from '../lib/i18n';
import { BOOKS, bookName, bookSlug, booksOf, getPosts, isOldTestament } from '../lib/posts';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const posts = await getPosts(lang);
const counts = new Map<string, number>();
for (const post of posts) for (const book of booksOf(post)) counts.set(book, (counts.get(book) ?? 0) + 1);

const cited = BOOKS.filter((b) => counts.has(b));
const groups = [
	{ name: tr.oldTestament, books: cited.filter(isOldTestament) },
	{ name: tr.newTestament, books: cited.filter((b) => !isOldTestament(b)) },
];
---

<Base lang={lang} title={tr.scriptureTitle} description={tr.scriptureLede}>
	<header class="page-head">
		<p class="eyebrow">{tr.scripture}</p>
		<h1>{tr.scriptureTitle}</h1>
		<p>{tr.scriptureLede}</p>
	</header>

	{cited.length === 0 && <p>{tr.noPosts} <a href="https://www.wbt4god.com/">wbt4god.com</a> {tr.forServiceTimes}</p>}

	{
		groups.map(
			(g) =>
				g.books.length > 0 && (
					<section class="group">
						<h2>{g.name}</h2>
						<ul>
							{g.books.map((book) => (
								<li>
									<a href={`${ROUTES[lang].scripture}${bookSlug(book, lang)}/`}>
										{bookName(book, lang)} <span class="n">{counts.get(book)}</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				),
		)
	}
</Base>

<style>
	.group {
		margin-bottom: 2.5rem;
	}

	h2 {
		font-size: 1.35rem;
		margin: 0 0 1rem;
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
		gap: 0.5rem;
	}

	a {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.6rem 0.9rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 8px;
		text-decoration: none;
		color: var(--text);
		font-weight: 700;
	}

	a:hover {
		border-color: var(--link);
		color: var(--link);
	}

	.n {
		font-weight: 400;
		font-size: 0.85rem;
		color: var(--text-muted);
	}
</style>
