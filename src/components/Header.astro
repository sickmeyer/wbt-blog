---
import { CHURCH } from '../consts';
import { type Lang, ROUTES, t } from '../lib/i18n';

interface Props {
	lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const tr = t(lang);
const r = ROUTES[lang];
const other: Lang = lang === 'en' ? 'es' : 'en';
const links = [
	{ href: r.home, label: tr.articles },
	{ href: r.scripture, label: tr.scripture },
	{ href: r.archive, label: tr.archive },
	{ href: r.search, label: tr.search },
	{ href: r.about, label: tr.about },
];
const path = Astro.url.pathname;
const home = r.home;
const isActive = (href: string) =>
	href === home
		? path === home || /^\d+\/$/.test(path.slice(home.length)) || path.startsWith(`${home}posts/`)
		: path.startsWith(href);
---

<a class="skip-link" href="#content">{tr.skip}</a>
<header class="site-header">
	<div class="bar">
		<a class="brand" href={r.home} aria-label={`${CHURCH.name}: ${tr.siteTitle}`}>
			<img src="/logo.png" alt={CHURCH.name} width="495" height="68" />
		</a>
		<nav aria-label="Main">
			<ul>
				{
					links.map((l) => (
						<li>
							<a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
								{l.label}
							</a>
						</li>
					))
				}
				<li><a class="lang-link" href={ROUTES[other].home} hreflang={other} lang={other} aria-label={tr.otherLangAria}>{tr.otherLangLabel}</a></li>
				<li><a class="home-link" href={CHURCH.url}>wbt4god.com ↗</a></li>
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		background: var(--navy);
		border-bottom: 4px solid var(--red);
		color: #fff;
	}

	.bar {
		max-width: 64rem;
		margin: 0 auto;
		padding: 0.9rem var(--gutter);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		flex-wrap: wrap;
	}

	.brand {
		display: block;
		line-height: 0;
		flex: 0 1 auto;
		max-width: 100%;
	}

	.brand img {
		height: 46px;
		width: auto;
		max-width: 100%;
	}

	nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.1rem;
	}

	nav a {
		color: #fff;
		text-decoration: none;
		font-weight: 700;
		font-size: 0.95rem;
		padding: 0.3rem 0;
		border-bottom: 2px solid transparent;
	}

	nav a:hover {
		border-bottom-color: var(--cream);
	}

	nav a[aria-current='page'] {
		border-bottom-color: var(--cream);
		color: var(--cream);
	}

	nav .lang-link {
		color: var(--cream);
	}

	nav .home-link {
		font-weight: 400;
		opacity: 0.85;
	}

	@media (max-width: 760px) {
		.bar {
			padding-top: 0.75rem;
			padding-bottom: 0.6rem;
		}

		.brand img {
			height: auto;
			width: 100%;
			max-width: 320px;
		}

		nav {
			width: 100%;
		}

		nav ul {
			gap: 0.1rem 1rem;
		}

		nav a {
			font-size: 0.92rem;
		}
	}
</style>
