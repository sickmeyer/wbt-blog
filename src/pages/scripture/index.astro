---
import Base from '../../layouts/Base.astro';
import { BOOKS, booksOf, getPosts, isOldTestament, slugify } from '../../lib/posts';

const posts = await getPosts();
const counts = new Map<string, number>();
for (const post of posts) for (const book of booksOf(post)) counts.set(book, (counts.get(book) ?? 0) + 1);

const cited = BOOKS.filter((b) => counts.has(b));
const groups = [
	{ name: 'Old Testament', books: cited.filter(isOldTestament) },
	{ name: 'New Testament', books: cited.filter((b) => !isOldTestament(b)) },
];
---

<Base title="Articles by Book of the Bible" description="Browse sermon articles by the books of the Bible they preach from and cite.">
	<header class="page-head">
		<p class="eyebrow">Scripture</p>
		<h1>Articles by Book of the Bible</h1>
		<p>Every book cited in an article, in canonical order. Numbers show how many articles draw on each.</p>
	</header>

	{cited.length === 0 && <p>No articles yet.</p>}

	{
		groups.map(
			(g) =>
				g.books.length > 0 && (
					<section class="group">
						<h2>{g.name}</h2>
						<ul>
							{g.books.map((book) => (
								<li>
									<a href={`/scripture/${slugify(book)}/`}>
										{book} <span class="n">{counts.get(book)}</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				),
		)
	}
</Base>

<style>
	.group {
		margin-bottom: 2.5rem;
	}

	h2 {
		font-size: 1.35rem;
		margin: 0 0 1rem;
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
		gap: 0.5rem;
	}

	a {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.6rem 0.9rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 8px;
		text-decoration: none;
		color: var(--text);
		font-weight: 700;
	}

	a:hover {
		border-color: var(--link);
		color: var(--link);
	}

	.n {
		font-weight: 400;
		font-size: 0.85rem;
		color: var(--text-muted);
	}
</style>
