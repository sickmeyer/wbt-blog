---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That page couldn't be found." noindex>
	<header class="page-head">
		<p class="eyebrow">404</p>
		<h1>That page isn't here</h1>
		<p>
			It may have moved, or the link may be mistyped. Try the <a href="/">latest articles</a>, the
			<a href="/archive/">archive</a>, or <a href="/search/">search</a>.
		</p>
	</header>
</Base>
